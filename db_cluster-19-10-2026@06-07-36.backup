COPY public.homework_submissions (id, homework_id, username, student_name, class_name, answers, note, status, score, max_score, feedback, time_used, submitted_at, graded_at, manual_scores, attempt, tab_violations, force_submitted, screenshot_violations) FROM stdin;
\.


